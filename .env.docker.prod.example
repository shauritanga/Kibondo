# Production Docker — copy to .env in project root before deploy:
#   cp .env.docker.prod.example .env
#   php artisan key:generate --show   # paste into APP_KEY
#   make prod-up
#
# Coolify: do not set HTTP_PORT and do not map host 8080. Proxy to port 80.
# Standalone Docker: HTTP_PORT publishes the web container on the host.
# Compose Postgres is the kibondo-db service. Do not set DB_HOST=localhost
# or DB_HOST=db (other Coolify apps often already use the name `db`).

APP_NAME="Kibondo Green Farm"
APP_KEY=
APP_URL=https://yourdomain.com

# HTTP_PORT=8080

DB_PASSWORD=
DB_USERNAME=kibondo
DB_DATABASE=kibondo_db

SESSION_SECURE_COOKIE=true
CORS_ALLOWED_ORIGINS=https://yourdomain.com
SANCTUM_STATEFUL_DOMAINS=yourdomain.com

MAIL_MAILER=resend
# RESEND_API_KEY=
MAIL_FROM_ADDRESS=sales@kibondogreenfarm.co.tz
MAIL_FROM_NAME="Kibondo Green Farm"
MAIL_CONTACT_TO=info@kibondogreenfarm.co.tz
CONTACT_FORM_SECRET=

# SENTRY_LARAVEL_DSN=

RUN_MIGRATE=true
