# Production Docker — copy to .env in project root before deploy:
#   cp .env.docker.prod.example .env
#   php artisan key:generate --show   # paste into APP_KEY
#   docker compose -f docker-compose.prod.yml up --build -d

APP_NAME="Kibondo Green Farm"
APP_KEY=
APP_URL=https://yourdomain.com

HTTP_PORT=8080

DB_PASSWORD=
DB_USERNAME=kibondo
DB_DATABASE=kibondo_db

SESSION_SECURE_COOKIE=true
CORS_ALLOWED_ORIGINS=https://yourdomain.com
SANCTUM_STATEFUL_DOMAINS=yourdomain.com

MAIL_MAILER=resend
# RESEND_API_KEY=
MAIL_CONTACT_TO=info@kibondogreenfarm.co.tz
CONTACT_FORM_SECRET=

# SENTRY_LARAVEL_DSN=

RUN_MIGRATE=true
